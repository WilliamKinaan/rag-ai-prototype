MISTRAL_API_KEY=

# In-memory rate limiter (webapp/rate_limiter.py) - allows this many calls
# to Mistral per window, then rejects with a 429 until the window resets.
# Mistral doesn't publish exact free-tier numbers; check your real limit at
# https://console.mistral.ai -> Admin Panel -> API -> Limits. This key is
# also used by two other live apps (llm-playground, chatagent), so set
# these to roughly this app's *share* of that limit (e.g. a third), not
# the whole thing — rate limits are enforced per workspace, shared across
# every key in it, not per key.
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=10

# Legal Assistant (Phase 1, webapp/legal_review.py) - only needed if you pick
# the matching option from that page's model dropdown. Each is independent;
# leave either blank and that dropdown option will just error clearly when
# picked. Not covered by the Mistral rate limiter above (see
# CONTEXT-legal-assistant.md).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Qwen (Alibaba Cloud DashScope, called via the OpenAI-compatible endpoint -
# see webapp/legal_review.py:call_qwen_review). Get a key from the Model
# Studio console's API Key page: bailian.console.alibabacloud.com
QWEN_API_KEY=
# Optional - only needed if the console's "OpenAI-compatible" endpoint URL
# shown for your workspace isn't the generic international one (it's
# workspace + region scoped, e.g. a Germany/eu-central-1 workspace gets its
# own host). Find it on the same API Key / model-service page as the key
# above; leave unset to use the generic international endpoint.
QWEN_BASE_URL=

# Admin auth (webapp/cf_access.py) - Cloudflare Access protects /admin and
# /api/admin/*. All three required for admin routes to work at all; if any
# is unset, admin routes fail closed (401) rather than opening up. See
# CONTEXT-admin-auth.md for exactly where each value comes from in the
# Cloudflare Zero Trust dashboard.
#
# Zero Trust team domain, e.g. yourteam.cloudflareaccess.com (no scheme).
CF_ACCESS_TEAM_DOMAIN=
# Comma-separated AUD tag(s) from the Access Application(s) protecting
# /admin* and /api/admin* (one tag per Application if you made two).
CF_ACCESS_AUD=
# Comma-separated emails of the admin users - a second check on top of
# Cloudflare's own Access policy, not a substitute for it.
ADMIN_ALLOWED_EMAILS=
