MISTRAL_API_KEY=

# In-memory rate limiter (webapp/rate_limiter.py) - allows this many calls
# to Mistral per window, then rejects with a 429 until the window resets.
# Mistral doesn't publish exact free-tier numbers; check your real limit at
# https://console.mistral.ai -> Admin Panel -> API -> Limits. This key is
# also used by two other live apps (llm-playground, chatagent), so set
# these to roughly this app's *share* of that limit (e.g. a third), not
# the whole thing — rate limits are enforced per workspace, shared across
# every key in it, not per key.
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=10
